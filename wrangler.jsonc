{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shiftbill",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Static files are served before the Worker runs and do not count towards the
  // 100,000 requests a day on the free plan. Only /api/* wakes the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiftbill",
      // Replace with the id printed by `npx wrangler d1 create shiftbill` (see LAUNCH_CHECKLIST.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  // Daily at 21:30 UTC, which is 7:30 or 8:30 am on the east coast. One of the 5 free cron slots.
  "triggers": { "crons": ["30 21 * * *"] },
  "observability": { "enabled": true },
  // Only non-secret settings live here. Everything else is a Worker secret, synced
  // from GitHub repository secrets by .github/workflows/deploy.yml.
  "vars": {
    "APP_ENV": "production",
    "PBKDF2_ITERATIONS": "10000"
  }
}
